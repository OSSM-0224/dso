# All env variables used by the platform (same names as the Express version).

# MongoDB connection string. Include the database name after the host, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dso
# If empty or unreachable the app runs on the in-process in-memory store.
MONGODB_URI=""

# JWT signing secret for auth/session cookies.
JWT_SECRET="dso-navi-mumbai-kho-kho-fixtures-jwt-secret-key-2026"

# TEMP-LOGIN: remove later
# Shared password for seeded developer accounts (seed script + /api/dev routes).
TEMP_LOGIN_PASSWORD="DSO@2026"
# Enables the temporary quick-login dropdown in the UI (dev only).
NEXT_PUBLIC_ENABLE_TEMP_LOGINS="true"
